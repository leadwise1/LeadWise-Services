rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // SECURE LMI INTAKE DATA
    // Path: artifacts/leadwise-web/users/{userId}/profile/intake
    // =====================================================
    match /artifacts/leadwise-web/users/{userId}/profile/intake {
      // Users can read/create/update their own entry. Admin can read all for reporting.
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.uid == "SJZjDTO19IbOC5wxFleA7koMITx1");
      allow create, update: if request.auth != null && request.auth.uid == userId;
      
      // Prevent deletion to maintain audit integrity for grant compliance
      allow delete: if false;
    }

    // =====================================================
    // FORUM POSTS
    // =====================================================
    match /artifacts/leadwise-web/public/data/forumPosts/{postId} { 
      allow read: if true;
      
      // Allow students (even those just passing the local intake gate) to post and upvote
      allow create, update: if true;
      
      // Only the verified Admin can delete posts to keep the community safe
      allow delete: if request.auth != null && request.auth.uid == "SJZjDTO19IbOC5wxFleA7koMITx1";

      // Explicitly allow comments subcollection (otherwise default deny blocks it)
      match /comments/{commentId} {
        allow read, create, update: if true;
        allow delete: if request.auth != null && request.auth.uid == "SJZjDTO19IbOC5wxFleA7koMITx1";
      }
    }
    
    // =====================================================
    // LEADERBOARD
    // =====================================================
    match /artifacts/leadwise-web/public/data/leaderboard/{docId} {
      allow read: if true;
      // XP and rankings should only be written by system functions or Admin.
      allow write: if false;
    }

    // =====================================================
    // SESSIONS / WEEKLY SYNCS
    // =====================================================
    match /artifacts/leadwise-web/public/data/sessions/{sessionId} {
      allow read: if true;
      // Sessions are managed via Admin SDK/Firebase Console
      allow write: if false;
    }

    // =====================================================
    // DEFAULT DENY
    // =====================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}