rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public access to the leaderboard and forum data
    match /artifacts/leadwise-web/public/data/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    // Default: block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
